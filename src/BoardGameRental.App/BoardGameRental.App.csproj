<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../BoardGameRental.Core/BoardGameRental.Core.csproj" />
    <None Include="../../sample-data/*.json" Link="sample-data/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The native library for the OS that is building; the C source is rebuilt with native/build.ps1 or native/build.sh. -->
    <None Include="../../runtimes/win-x64/native/boardgame_native.dll" Link="boardgame_native.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="$([MSBuild]::IsOSPlatform('Windows')) And Exists('../../runtimes/win-x64/native/boardgame_native.dll')" />
    <None Include="../../runtimes/osx-arm64/native/libboardgame_native.dylib" Link="libboardgame_native.dylib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="$([MSBuild]::IsOSPlatform('OSX')) And Exists('../../runtimes/osx-arm64/native/libboardgame_native.dylib')" />
    <None Include="../../runtimes/linux-x64/native/libboardgame_native.so" Link="libboardgame_native.so" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="$([MSBuild]::IsOSPlatform('Linux')) And Exists('../../runtimes/linux-x64/native/libboardgame_native.so')" />
  </ItemGroup>
</Project>
